# Copy to apps/api/.env and adjust. Never commit the real .env.

# Local Postgres from docker-compose.yml (credentials are local-only).
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
# Used by `pnpm test:integration`.
TEST_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse_test

PORT=4000
APP_VERSION=dev

# Added in later phases:
# JWT_SECRET=           # 32+ random bytes, e.g. `openssl rand -hex 32`
# ENCRYPTION_KEY=       # 32 bytes hex, encrypts alert secrets (AES-256-GCM)
# CHECKER_URL=http://localhost:8787
# CHECKER_HMAC_SECRET=  # must match apps/checker/.dev.vars
# SENTRY_DSN=
