# Copy to apps/api/.env and adjust. Never commit the real .env.

# Local Postgres from docker-compose.yml (credentials are local-only).
DATABASE_URL=postgresql://pulse:pulse@localhost:5434/pulse
# Used by `pnpm test:integration`.
TEST_DATABASE_URL=postgresql://pulse:pulse@localhost:5434/pulse_test

PORT=4000
APP_VERSION=dev

# Signs access tokens. At least 32 characters; generate one with: openssl rand -hex 32
JWT_SECRET=
# Encrypts secrets stored in the database (monitor header values). 64 hex characters:
# openssl rand -hex 32. The checker needs the same value.
ENCRYPTION_KEY=

# The checker Worker. To use it locally, run `pnpm --filter @pulse/checker dev` and set
# CHECKER_URL=http://localhost:8787 plus the secret below. Leave both empty to run the API
# without it: monitors then only show the status stored at the last flush.
CHECKER_URL=
# Signs API -> checker requests. Must match apps/checker/.dev.vars: openssl rand -hex 24
CHECKER_HMAC_SECRET=

# Added in later phases:
# SENTRY_DSN=
