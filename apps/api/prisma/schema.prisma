// Tables from docs/ERD.md. CHECK constraints and partial indexes live in the migration SQL
// (Prisma doesn't model them).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum HttpMethod {
  GET
  HEAD

  @@map("http_method")
}

enum MonitorStatus {
  pending
  up
  failing
  down
  recovering
  paused

  @@map("monitor_status")
}

enum ResolveReason {
  recovered
  paused
  deleted

  @@map("resolve_reason")
}

enum ChannelType {
  discord
  telegram

  @@map("channel_type")
}

enum ChannelState {
  /// Telegram channel waiting for the user to send /start <code> to the bot.
  pending_link
  active
  disabled

  @@map("channel_state")
}

enum AlertEvent {
  opened
  resolved

  @@map("alert_event")
}

enum DeliveryState {
  pending
  sent
  suppressed
  failed

  @@map("delivery_state")
}

enum CheckError {
  status
  timeout
  dns
  tls
  connection

  @@map("check_error")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lowercased; uniqueness is case-insensitive because of that.
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  projects      Project[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// All tokens descended from one login share a family; reuse revokes the family.
  familyId   String    @map("family_id") @db.Uuid
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash  Bytes     @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  name       String
  slug       String   @unique
  isPublic   Boolean  @default(true) @map("is_public")
  statusNote String?  @map("status_note")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  monitors Monitor[]
  channels AlertChannel[]

  @@index([ownerId])
  @@map("projects")
}

model Monitor {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String        @map("project_id") @db.Uuid
  name              String
  url               String
  method            HttpMethod    @default(GET)
  expectedStatusMin Int           @default(200) @map("expected_status_min") @db.SmallInt
  expectedStatusMax Int           @default(399) @map("expected_status_max") @db.SmallInt
  timeoutMs         Int           @default(8000) @map("timeout_ms") @db.SmallInt
  failureThreshold  Int           @default(3) @map("failure_threshold") @db.SmallInt
  /// Header name -> encrypted value (AES-256-GCM). Values are never returned by the API.
  headers           Json          @default("{}")
  isPaused          Boolean       @default(false) @map("is_paused")
  showOnStatusPage  Boolean       @default(true) @map("show_on_status_page")
  /// Checker shard 0-4, fixed at creation.
  shard             Int           @db.SmallInt
  lastStatus        MonitorStatus @default(pending) @map("last_status")
  lastCheckedAt     DateTime?     @map("last_checked_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkResults CheckResult[]
  incidents    Incident[]

  @@index([projectId])
  @@index([shard])
  @@map("monitors")
}

model CheckResult {
  monitorId  String      @map("monitor_id") @db.Uuid
  checkedAt  DateTime    @map("checked_at") @db.Timestamptz(3)
  ok         Boolean
  statusCode Int?        @map("status_code") @db.SmallInt
  latencyMs  Int?        @map("latency_ms")
  error      CheckError?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([monitorId, checkedAt])
  @@map("check_results")
}

model Incident {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monitorId      String         @map("monitor_id") @db.Uuid
  /// Time of the first failed check in the run that opened the incident.
  startedAt      DateTime       @map("started_at") @db.Timestamptz(3)
  /// Time of the first successful check of the recovery. Null while open.
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(3)
  cause          CheckError
  lastStatusCode Int?           @map("last_status_code") @db.SmallInt
  resolveReason  ResolveReason? @map("resolve_reason")
  note           String?

  monitor    Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  // Plus, in SQL: unique (monitor_id) WHERE resolved_at IS NULL.
  @@index([monitorId, startedAt(sort: Desc)])
  @@map("incidents")
}

model AlertChannel {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  type            ChannelType
  name            String
  /// Discord webhook URL or Telegram chat id, encrypted (AES-256-GCM, "v1." format).
  secretEnc       String?      @map("secret_enc")
  cooldownMinutes Int          @default(10) @map("cooldown_minutes") @db.SmallInt
  state           ChannelState @default(active)
  disabledReason  String?      @map("disabled_reason")
  /// Telegram linking: SHA-256 of the one-time /start code, and when it expires.
  linkCodeHash    String?      @unique @map("link_code_hash")
  linkExpiresAt   DateTime?    @map("link_expires_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([projectId])
  @@map("alert_channels")
}

/// The alert outbox: one row per incident event per channel (docs/ARCHITECTURE.md §3.4).
model AlertDelivery {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId    String        @map("incident_id") @db.Uuid
  channelId     String        @map("channel_id") @db.Uuid
  event         AlertEvent
  state         DeliveryState @default(pending)
  attempts      Int           @default(0) @db.SmallInt
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?       @map("last_error")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(3)

  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel  AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// The idempotency key: one delivery per incident event per channel (duplicate-alert layer 3).
  @@unique([incidentId, channelId, event])
  @@index([channelId, event, sentAt(sort: Desc)])
  @@map("alert_deliveries")
}
