# Copy to apps/checker/.dev.vars for `wrangler dev`. Never commit the real file.
# In Cloudflare these are set with `wrangler secret put <NAME>`.

ENVIRONMENT=local

# Local Postgres. With DB_DRIVER=pg the Worker uses node-postgres over TCP
# (works in workerd with nodejs_compat); in Cloudflare it uses Neon's HTTP driver.
DB_DRIVER=pg
DATABASE_URL=postgresql://pulse:pulse@localhost:5434/pulse

# Must match apps/api/.env.
CHECKER_HMAC_SECRET=
ENCRYPTION_KEY=

# Added in later phases:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
