{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["@pulse/shared#build", "@pulse/api#build"],
      "cache": false,
      "env": ["E2E_DATABASE_URL"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    }
  }
}
